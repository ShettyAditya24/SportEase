<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Expense Chart"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#f2a02b"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"/>

    <!-- Artificial Grass Cost -->
    <TextView
        android:id="@+id/tvLabelArtificialGrass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Artificial Grass Cost:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvArtificialGrassCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Side Net Cost -->
    <TextView
        android:id="@+id/tvLabelSideNet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Side Net Cost:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelArtificialGrass"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvSideNetCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvArtificialGrassCost"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Salary Cost -->
    <TextView
        android:id="@+id/tvLabelSalary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salary Cost:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelSideNet"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvSalaryCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvSideNetCost"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Booking Revenue -->
    <TextView
        android:id="@+id/tvLabelBookingRevenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Booking Revenue:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelSalary"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvBookingRevenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvSalaryCost"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/tvBookingRevenue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Total Expense -->
    <TextView
        android:id="@+id/tvLabelTotalExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Expense:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvTotalExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Profit -->
    <TextView
        android:id="@+id/tvLabelProfit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remaining Profit:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/tvLabelTotalExpense"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvProfit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/tvTotalExpense"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
